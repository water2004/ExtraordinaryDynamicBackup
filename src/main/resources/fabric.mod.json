{
  "schemaVersion": 1,
  "id": "extraordinarydynamicbackup",
  "version": "${version}",
  "name": "ExtraordinaryDynamicBackup",
  "description": "Experimental regional hot backup and restore for Minecraft 26.3.",
  "environment": "*",
  "mixins": ["extraordinarydynamicbackup.mixins.json", "adaptors/c2me.mixins.json", "adaptors/carpet.mixins.json", "adaptors/carpet_tis_addition.mixins.json", "adaptors/gca.mixins.json", "adaptors/vmp.mixins.json", "adaptors/scalablelux.mixins.json", "adaptors/async.mixins.json", "adaptors/chunky.mixins.json"],
  "entrypoints": {
    "main": ["org.edtp.ExtraordinaryDynamicBackup"],
    "client": ["org.edtp.ExtraordinaryDynamicBackupClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
